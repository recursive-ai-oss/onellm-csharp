<Project Sdk="Microsoft.NET.Sdk">

  <!-- The happy path against a real provider. Set OPENAI_API_KEY (or the key of the provider whose model you pass), then run
       this project with the model name as its argument. It sends a few small requests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Samples.HappyPath</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneLlm/OneLlm.csproj" />
    <None Include="commit-message.flow" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
