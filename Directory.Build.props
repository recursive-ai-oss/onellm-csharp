<Project>

  <PropertyGroup Label="Name">
    <!-- The one place the project name lives. Assembly and namespace names stay $(LibName). -->
    <LibName>OneLlm</LibName>
    <!-- NuGet package IDs carry the publisher prefix; this is the only place it is written. -->
    <PackagePrefix>RecursiveAI.</PackagePrefix>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <!-- Build output stays out of the source folders. Set ONELLM_ARTIFACTS to choose where; the default is artifacts/ at the
         repository root, which .gitignore covers. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ONELLM_ARTIFACTS)' != ''">$(ONELLM_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ONELLM_ARTIFACTS)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="Language and analysis">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible packages">
    <!-- Path mapping is for the packages only (projects under src/). Test projects keep real paths: some tests locate
         test data from [CallerFilePath], which a mapped path would break on CI. -->
    <_ProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <_SrcDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_SrcDir>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' and $(_ProjectDir.StartsWith('$(_SrcDir)'))">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright (c) Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <!-- The one place the package version lives; every package in this repository shares it. -->
    <Version>0.1.0-preview.1</Version>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/recursive-ai-oss/onellm-csharp</RepositoryUrl>
    <PackageProjectUrl>https://recursiveai.org/onellm/</PackageProjectUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
