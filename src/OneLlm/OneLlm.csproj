<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(LibName)</AssemblyName>
    <RootNamespace>$(LibName)</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName)</PackageId>
    <IsPackable>true</IsPackable>
    <Description>LLM inference and agent runtime for .NET: Anthropic, OpenAI and Gemini clients, a provider-neutral message model, a layered model catalog with decimal line-item pricing, and a happy-path API. Unaffiliated with the PyPI onellm package and the OneLLM research model.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>llm;ai;agents;anthropic;openai;gemini;chat;streaming;tools;structured-output;embeddings;nativeaot;trimmable</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <!-- The core package depends on the base class library and Recursive AI libraries only. -->
  <ItemGroup>
    <PackageReference Include="OneYaml" />
    <PackageReference Include="RecursiveAI.OneImage" />
  </ItemGroup>

  <!-- The model catalog entries that ship with each provider. -->
  <ItemGroup>
    <EmbeddedResource Include="Providers/Gemini/llm-provider.yaml" LogicalName="$(LibName).Providers.Gemini.llm-provider.yaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Tests" />
    <InternalsVisibleTo Include="$(LibName).Conformance" />
    <InternalsVisibleTo Include="$(LibName).Bench" />
    <InternalsVisibleTo Include="$(LibName).Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The source generators are built first and shipped in the package as analyzers, so adding the package is all it takes.
       They are build-time tools and add no dependency. -->
  <ItemGroup>
    <ProjectReference Include="../OneLlm.Generators/OneLlm.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeGeneratorsInPackage" BeforeTargets="_GetPackageFiles">
    <!-- Packing with no build ships the generators the earlier build produced; building again here would fail, because the
         no-build setting reaches this project too. -->
    <MSBuild Projects="../OneLlm.Generators/OneLlm.Generators.csproj" Targets="Build" Condition="'$(NoBuild)' != 'true'" />
    <MSBuild Projects="../OneLlm.Generators/OneLlm.Generators.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_GeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_GeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
