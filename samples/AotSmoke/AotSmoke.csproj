<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publishes NativeAOT with the trim and AOT analyzers on: `dotnet publish samples/AotSmoke -r linux-x64`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="triage.decider.yaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneLlm/OneLlm.csproj" />
    <!-- Tools written with [Tool] get their code from the generator, as they do when the package is referenced. -->
    <ProjectReference Include="../../src/OneLlm.Generators/OneLlm.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
