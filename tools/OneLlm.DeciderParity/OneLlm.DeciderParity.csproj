<Project Sdk="Microsoft.NET.Sdk">

  <!-- Decider request-byte parity driver: runs deciders through the Jev engine against a capturing stub and compares the request bytes
       with those an external reference server sent for the same decider, inputs and context window. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).DeciderParity</RootNamespace>
    <AssemblyName>onellm-deciderparity</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneLlm/OneLlm.csproj" />
  </ItemGroup>

</Project>
