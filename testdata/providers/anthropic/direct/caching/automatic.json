{
  "format": 1,
  "description": "Automatic caching: one top-level cache_control that follows the conversation. Written from the API reference (https://platform.claude.com/docs/en/build-with-claude/prompt-caching); not recorded from a live call.",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/messages",
        "headers": {
          "anthropic-version": "2026-10-21",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-sonnet-5-5",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "Say hello."
                }
              ]
            }
          ],
          "cache_control": {
            "type": "ephemeral"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "msg_01Aq9w938a90dw8q",
          "type": "message",
          "role": "assistant",
          "model": "claude-sonnet-5-5",
          "content": [
            {
              "type": "text",
              "text": "Hello!"
            }
          ],
          "stop_reason": "end_turn",
          "stop_sequence": null,
          "usage": {
            "input_tokens": 5,
            "output_tokens": 4,
            "cache_creation_input_tokens": 1500,
            "cache_read_input_tokens": 0
          }
        }
      }
    }
  ]
}
