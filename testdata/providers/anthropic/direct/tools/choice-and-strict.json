{
  "format": 1,
  "description": "tool_choice forcing one tool with parallel calls off, and a strict tool. Written from the API reference (https://platform.claude.com/docs/en/api/messages); not recorded from a live call.",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/messages",
        "headers": {
          "anthropic-version": "2026-10-21",
