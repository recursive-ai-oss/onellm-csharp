<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cost parity driver: prices a grid of usages for every model of a set of llm-provider.yaml files with OneLLM's pricing engine and
       with an external reference calculator that is run as a black box, and compares the two line by line. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).CostParity</RootNamespace>
    <AssemblyName>onellm-costparity</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneLlm/OneLlm.csproj" />
  </ItemGroup>

</Project>
