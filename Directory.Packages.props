<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Shipped dependencies of the core package: Recursive AI libraries only. -->
  <ItemGroup>
    <PackageVersion Include="OneYaml" Version="1.2.1" />
    <PackageVersion Include="RecursiveAI.OneImage" Version="1.10.4" />
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.5.1" />
  </ItemGroup>
  <!-- Adapter dependencies: each adapter package references core and exactly one of these. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="RecursiveAI.OneLite" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
  </ItemGroup>
  <!-- Build-time and test-only packages. The library depends on none of these. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <!-- Speed references: black-box, restored into bench/ only. Never referenced by anything that ships. -->
  <ItemGroup>
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <PackageVersion Include="Anthropic" Version="13.5.0" />
    <PackageVersion Include="Google.GenAI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.27.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
  </ItemGroup>
</Project>
